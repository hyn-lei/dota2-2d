{
  "name": "ancient-front",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A playable Canvas 2D MOBA inspired by Dota 2.",
  "scripts": {
    "dev": "node scripts/server.mjs",
    "start": "node scripts/server.mjs",
    "build": "node scripts/build.mjs",
    "check:build": "node --experimental-vm-modules scripts/check-static-build.mjs",
    "test:container": "node scripts/smoke-container.mjs",
    "test:multiplayer-server": "node --test tests/multiplayer-server.test.mjs",
    "test:multiplayer-smoke": "node scripts/smoke-multiplayer.mjs",
    "test:public-coop": "node scripts/check-public-coop.mjs",
    "test:deployment": "node scripts/smoke-browser.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:vfx": "node tests/browser-vfx.mjs",
    "test:ai": "node tests/browser-ai.mjs",
    "test:ogre": "node tests/browser-ogre.mjs",
    "test:coop": "node tests/browser-coop.mjs",
    "test:notice": "node tests/browser-notice.mjs",
    "test:recovery": "node tests/browser-recovery.mjs"
  },
  "devDependencies": {
    "playwright": "^1.56.1",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "ws": "^8.22.1"
  }
}
