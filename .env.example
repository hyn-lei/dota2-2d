# Use a published tag or an immutable @sha256:... digest from Actions.
IMAGE=ghcr.io/hyn-lei/dota2-2d:latest
HTTP_PORT=8080
# Use 127.0.0.1 when a reverse proxy on the host handles public traffic.
# The reverse proxy must forward WebSocket Upgrade/Connection for /ws/coop.
# HTTP and cooperative WebSocket traffic share the container's port 8080.
BIND_ADDRESS=0.0.0.0
